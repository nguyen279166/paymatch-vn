{
  "name": "paymatch-api",
  "version": "0.1.0",
  "private": true,
  "description": "API backend doi soat thanh toan chuyen khoan - PayMatch VN",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
